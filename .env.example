# Keep real values in .env locally or in GitHub Actions Secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=7
TELEGRAM_MAX_RESPONSES=20
TELEGRAM_ALLOW_STACK_MISMATCH=false

# Optional. Paths are relative to the current working directory.
JOBRADAR_STATE_PATH=data/state.json
JOBRADAR_MAX_SEND=10
JOBRADAR_HISTORY_LIMIT=10000
MAX_PROJECT_AGE_HOURS=24
HOT_PROJECT_AGE_HOURS=6
FREELANCE_RU_ENABLED=true
HABR_FREELANCE_ENABLED=true
FL_RU_ENABLED=true
TELEGRAM_PUBLIC_ENABLED=true
TELEGRAM_PUBLIC_CHANNELS=freelansim_ru,digitaltender,job_for_bots,freelancetaverna
WEBLANCER_ENABLED=false
